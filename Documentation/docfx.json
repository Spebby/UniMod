{
  "metadata": [
    {
      "src": [
        {
          "src": "../.",
          "files": ["**/*.csproj"],
          "exclude": [
            "Library/**",
            "Logs/**",
            "obj/**",
            "ProjectSettings/**",
            "Temp/**",
            "UserSettings/**",
            "Packages/**",
            "Unity.InternalAPIEditorBridgeDev.*.csproj"
          ]
        }
      ],
      "globalNamespaceId": "Global",
      "filter": "filterConfig.yml",
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": true,
      "allowCompilationErrors": true
    }
  ],
  "build": {
    "globalMetadata": {
      "_appTitle": "UniMod documentation",
      "_appFooter": "UniMod documentation",
      "_enableSearch": true
    },
    "content": [
      {
        "src": ".",
        "files": ["toc.yml", "index.md"]
      },
      {
        "src": "api/",
        "files": ["*.yml", "index.md"],
        "dest": "api"
      },
      {
        "src": "guides/",
        "files": ["toc.yml", "*.md"],
        "dest": "guides"
      }
    ],
    "overwrite": [
      {
        "src": "..",
        "files": ["Runtime/**/*.md"]
      },
      {
        "src": "overwrite",
        "files": ["**/*.md"]
      }
    ],
    "resource": [
      {
        "files": ["resources/**/*"]
      }
    ],
    "sitemap": {
      "baseUrl": "https://spebby.net/UniMod",
      "changefreq": "weekly",
      "fileOptions": {
        "api/*": {
          "changefreq": "daily"
        }
      }
    },
    "xref": [
      "https://normanderwan.github.io/UnityXrefMaps/6000.0/xrefmap.yml",
      "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"
    ],
    "dest": "../_site",
    "template": ["default", "modern"]
  }
}
